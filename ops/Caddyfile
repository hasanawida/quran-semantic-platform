# وسيط عكسي بأصل واحد: الواجهة والـ API تحت نطاق واحد.
# فائدتان: لا حاجة إلى CORS، وعامل الخدمة يستطيع تخزين طلبات الـ API
# لأنها من أصله نفسه.

{$SITE_DOMAIN} {
	encode zstd gzip

	# سقف حجم الجسم عند الحافّة — دفاع أول قبل التطبيق.
	#
	# **لماذا هنا لا في التطبيق وحده:** حدّ الحجم في الـAPI يقرأ ترويسة
	# `Content-Length`، فطلب بـ`Transfer-Encoding: chunked` يتجاوزه. وأشدّ
	# منه أن FastAPI يقرأ جسم الطلب كاملًا في الذاكرة **قبل** حلّ
	# الاعتماديات، أي قبل التحقق من الصلاحية — فمهاجم بلا رمز تفويض يرسل
	# جسمًا ضخمًا فيستنزف الذاكرة قبل أن يصله الرفض. وCaddy يعدّ البايتات
	# فعلًا فلا يُخدع بالترويسة. (رصده فحص جاهزية النشر 2026-07-25.)
	request_body {
		max_size 2MB
	}

	# استيراد إصدار نص: الاستثناء الوحيد، وحمولته المصحف كاملًا (~2.5 م.ب).
	# محصور بمساره وحده لا مرفوع على الموقع كله.
	@import path /api/v1/admin/quran-versions/import
	handle @import {
		request_body {
			max_size 32MB
		}
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	# سلامة النص: لا يُخزَّن رد الـ API في وسيط مشترك؛ حالة المراجعة
	# والصلاحيات قد تختلف بين مستخدم وآخر.
	@api path /api/* /health
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
