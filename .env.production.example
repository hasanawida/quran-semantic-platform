# نشر الإنتاج — انسخه إلى .env واملأ كل القيم قبل الإقلاع.
# لا تترك أي قيمة افتراضية في سر أو كلمة مرور.

# ---- قاعدة البيانات ----
POSTGRES_DB=quran_research
# دور المالك: يشغّل الهجرات فقط، ولا يستعمله التطبيق
POSTGRES_OWNER=quran_owner
POSTGRES_OWNER_PASSWORD=
# دور التطبيق: بلا DDL وبلا حذف من سجل التدقيق (راجع DEPLOYMENT_AR.md)
POSTGRES_APP_USER=quran_app
POSTGRES_APP_PASSWORD=

# ---- الأمان ----
# ولّده بـ: openssl rand -base64 48
JWT_SECRET=

# ---- العناوين العامة ----
# أصل الموقع بالضبط (بلا شرطة مائلة في آخره) — يُستعمل لـ CORS
PUBLIC_WEB_ORIGIN=https://example.org
# عنوان الـ API كما يراه المتصفح؛ يُدمج في حزمة الواجهة وقت البناء
PUBLIC_API_URL=https://example.org/api/v1

# ---- الحدود (اختيارية) ----
RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_REQUESTS=10

# ---- الوسيط العكسي ----
# النطاق الذي يخدم الموقع؛ Caddy يستخرج شهادة TLS له تلقائيًا
SITE_DOMAIN=example.org
