# ملفات المصادر الخام تنزّل ببناء الحزمة (كبيرة، خارجية) — تبقى محليًا
data/raw/
# الحزمة المبنية (quran_bundle.json.gz) تُحفظ لأنها تحمل بصمات مصادرها

# قاعدة بيانات التطوير المحلية (SQLite) تُبنى وتُبذر عند الإقلاع
*.db
*.db-journal
*.db-wal

# أثر بناء حزمة بايثون — يُولَّد عند التثبيت
*.egg-info/

# أثر بناء TypeScript — يُولَّد عند كل فحص أنواع
*.tsbuildinfo

# مخرجات التصدير الثابت — تُبنى في سير النشر وتُرفع artifact، ولا تُلتزم.
# بناء محلي واحد يترك ~22 م.ب من HTML يحمل النص القرآني بلا تتبّع.
/apps/web/out/
/apps/web/.next-prod/

# شجرة البيانات المولَّدة (242 ملفًا) — تُشتق من الحزمتين الموثقتين بأمر
# واحد، وإدخالها في التاريخ يضخّمه مع كل إصدار بيانات.
/apps/web/public/data/
